# Configuration FlatPulse : variables d'environnement, validées par
# flatpulse.config.Config au démarrage. Copier vers .env et remplir ; ne jamais
# committer .env : il porte des secrets.
#
# Rien ne lit .env tout seul : le charger dans le shell avant de lancer,
#   set -a; . ./.env; set +a
# (docker compose le passera par env_file, #63).

# --- Obligatoires : sans elles, l'application refuse de démarrer -------------

# Connexion PostgreSQL 16, schéma dans sql/schema.sql.
# Exemple : postgresql://flatpulse:motdepasse@localhost:5432/flatpulse
DATABASE_URL=
# Jeton du bot Telegram, donné par @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Optionnelles : la valeur indiquée est celle prise si la variable manque ---

# Niveau de log : DEBUG, INFO, WARNING, ERROR ou CRITICAL (sinon, refus de démarrer).
# Le format des logs (LOG_FORMAT, JSON en prod) arrive avec #74.
LOG_LEVEL=INFO
# Intervalle de polling par défaut, en secondes (entier > 0), d'une source sans valeur propre
# (sources.poll_interval_s).
POLL_INTERVAL_DEFAULT=120
